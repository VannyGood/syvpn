generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionPlanType {
  monthly
  yearly
  trial
}

enum SubscriptionStatus {
  active
  inactive
}

enum TransactionCurrency {
  TON
  TRC20
  WHISH
  USD
}

enum TransactionKind {
  deposit
  purchase
}

enum TransactionStatus {
  pending
  paid
  declined
}

model User {
  id         String         @id @default(uuid())
  telegramId String         @unique @map("telegram_id")
  username   String?
  trialClaimedAt DateTime?  @map("trial_claimed_at")
  referralCode String?      @unique @map("referral_code")
  referredById String?      @map("referred_by_id")
  referralRewardedAt DateTime? @map("referral_rewarded_at")
  createdAt  DateTime       @default(now()) @map("created_at")

  subscriptions Subscription[]
  transactions  Transaction[]
  referredBy User? @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals  User[] @relation("UserReferrals")

  @@index([referredById])
  @@map("users")
}

model Subscription {
  id            String             @id @default(uuid())
  userId        String             @map("user_id")
  planType      SubscriptionPlanType @map("plan_type")
  status        SubscriptionStatus @default(inactive)
  expiresAt     DateTime           @map("expires_at")
  marzbanUserId String?            @map("marzban_user_id")
  /// Marzban subscription URL (upstream). Not shown to users — use publicSubToken + /sub/:token proxy.
  configUrl       String?            @map("config_url")
  publicSubToken  String?            @unique @map("public_sub_token")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  subDevices SubDeviceFingerprint[]

  @@index([userId])
  @@map("subscriptions")
}

/// v2: fingerprints = one slot per client IP (max 2 distinct IPs per subscription).
model SubDeviceFingerprint {
  id             String   @id @default(uuid())
  subscriptionId String   @map("subscription_id")
  fpHash         String   @map("fp_hash")
  createdAt      DateTime @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, fpHash])
  @@index([subscriptionId])
  @@map("sub_device_fingerprints")
}

model Transaction {
  id        String             @id @default(uuid())
  userId    String             @map("user_id")
  amount    Decimal            @db.Decimal(12, 2)
  currency  TransactionCurrency
  kind      TransactionKind    @default(deposit)
  status    TransactionStatus  @default(pending)
  approvalToken String         @unique @map("approval_token")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("transactions")
}

