NODE_ENV=production
PORT=8080

# Compose will create Postgres automatically.
POSTGRES_PASSWORD=replace_me_db_password

# Prisma uses this (inside docker it must use host `db`)
DATABASE_URL=postgresql://syvpn:replace_me_db_password@127.0.0.1:5432/syvpn?schema=public

# JWT
JWT_SECRET=replace_me_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Telegram
TELEGRAM_BOT_TOKEN=replace_me

# Marzban (IMPORTANT: use host root; pasting /dashboard is OK too)
MARZBAN_URL=http://127.0.0.1:8000
# If MARZBAN_URL is https://syvpn.store/... but subscription links use the same host, set:
# MARZBAN_INTERNAL_ORIGIN=http://127.0.0.1:8000
MARZBAN_USERNAME=replace_me
MARZBAN_PASSWORD=replace_me

# Your Mini App frontend origin(s)
CORS_ORIGIN=http://localhost:5173

