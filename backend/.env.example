NODE_ENV=development
PORT=8080

# Used by Prisma (local dev now, VPS later)
DATABASE_URL=postgresql://user:password@localhost:5432/vpn?schema=public

# JWT
JWT_SECRET=replace_me_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Telegram login verification
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token_here

# Marzban API (VPS)
MARZBAN_URL=http://YOUR_VPS_IP:8000
MARZBAN_USERNAME=admin
MARZBAN_PASSWORD=yourpassword

# CORS (comma-separated)
CORS_ORIGIN=http://localhost:5173

